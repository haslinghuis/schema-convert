*_SCH.json

# Firmware capability data is generated by seed_firmware.py from a local
# Betaflight tree. Not committed: it would go stale, it records which checkout
# (and branch) it came from, and anyone running these tools has a tree to
# generate it from. install.sh tells you when it is missing.
mcu-parser/data/firmware.json

