{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Betaflight Target Generator",
  "version": "0.1.0",
  "identifier": "com.betaflight.schema-convert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Betaflight Target Generator",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Schematic PDF to Betaflight config.h",
    "longDescription": "Reads a flight-controller schematic PDF and generates a Betaflight config.h target, validating every pin against Betaflight's own hardware tables."
  }
}
